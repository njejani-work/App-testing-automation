{
    "name": "safaridriver",
    "version": "3.0.0",
    "author": "Christian Bromann <mail@bromann.dev>",
    "license": "MIT",
    "description": "An NPM wrapper for handling the Safaridriver binary.",
    "homepage": "https://github.com/webdriverio/driver/tree/main/packages/node-safaridriver#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webdriverio/driver.git",
        "directory": "packages/node-safaridriver"
    },
    "keywords": [
        "safari",
        "safaridriver",
        "webdriver",
        "webdriverio",
        "selenium"
    ],
    "bugs": {
        "url": "https://github.com/webdriverio/driver/issues"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "main": "./dist/cjs/index.js",
    "type": "module",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        }
    },
    "types": "./dist/cjs/index.d.ts",
    "scripts": {
        "build": "tsc -b . && node ../../scripts/copy-cjs-pkg.mjs",
        "clean": "rimraf ./dist ./tsconfig.tsbuildinfo",
        "test": "run-s test:*",
        "test:lint": "oxlint .",
        "test:typecheck": "tsc -p tsconfig.test.json",
        "test:unit": "vitest run --coverage",
        "test:interop": "node ./tests/interop/cjs.test.js",
        "check:pack": "node ../../scripts/check-pack.mjs && publint && attw --pack . --ignore-rules false-export-default",
        "watch": "pnpm run build -- --watch"
    }
}

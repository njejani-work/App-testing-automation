{
  "name": "geckodriver",
  "version": "8.0.0",
  "description": "Mozilla's Geckodriver for Node.js",
  "homepage": "https://github.com/webdriverio/driver/tree/main/packages/node-geckodriver#readme",
  "license": "MIT",
  "author": {
    "name": "vladikoff",
    "email": "vlad.filippov@gmail.com",
    "url": "http://vf.io"
  },
  "contributors": [
    {
      "name": "Christian Bromann",
      "url": "https://bromann.dev",
      "email": "mail@bromann.dev"
    }
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "geckodriver",
    "webdriver"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/driver.git",
    "directory": "packages/node-geckodriver"
  },
  "scripts": {
    "build": "tsc -b . && node ../../scripts/copy-cjs-pkg.mjs",
    "clean": "rimraf ./dist ./tsconfig.tsbuildinfo",
    "postinstall": "node -e \"if (require('fs').existsSync('./dist/install.js')) { process.exit(1) } console.log('Skipping install, project not built!')\" || node ./dist/install.js || echo Skipping install, the driver download failed.",
    "test": "run-s build test:*",
    "test:lint": "oxlint .",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "vitest --run --coverage",
    "check:pack": "node ../../scripts/check-pack.mjs && publint && attw --pack .",
    "watch": "pnpm run build -- --watch"
  },
  "bin": {
    "geckodriver": "./bin/geckodriver.js"
  },
  "bugs": {
    "url": "https://github.com/webdriverio/driver/issues"
  },
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0",
    "decamelize": "^6.0.1",
    "modern-tar": "^0.8.5",
    "undici": "^8.11.2"
  },
  "peerDependencies": {
    "@wdio/logger": "^9.18.0 || ^10.0.0"
  },
  "devDependencies": {
    "@wdio/logger": "^10.0.0"
  }
}

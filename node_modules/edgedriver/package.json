{
  "name": "edgedriver",
  "version": "8.0.0",
  "description": "Microsoft's EdgeDriver for Node.js",
  "homepage": "https://webdriver.io",
  "license": "MIT",
  "author": {
    "name": "Barrett Sonntag",
    "email": "barrett@sosuke.com",
    "url": "https://www.sosuke.com"
  },
  "keywords": [
    "edgedriver",
    "edgedriverserver",
    "webdriver"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/driver.git",
    "directory": "packages/node-edgedriver"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "bin": {
    "edgedriver": "./bin/edgedriver.js"
  },
  "scripts": {
    "build": "tsc -b . && node ../../scripts/copy-cjs-pkg.mjs",
    "clean": "rimraf ./dist ./tsconfig.tsbuildinfo",
    "postinstall": "node -e \"if (require('fs').existsSync('./dist/install.js')) { process.exit(1) } console.log('Skipping install, project not built!')\" || node ./dist/install.js || echo Skipping install, the driver download failed.",
    "test": "run-s test:*",
    "test:lint": "oxlint .",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "vitest --run --coverage",
    "check:pack": "node ../../scripts/check-pack.mjs && publint && attw --pack .",
    "watch": "pnpm run build -- --watch"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0",
    "decamelize": "^6.0.1",
    "undici": "^8.11.2"
  },
  "peerDependencies": {
    "@wdio/logger": "^9.29.1 || ^10.0.0"
  },
  "devDependencies": {
    "@wdio/logger": "^10.0.0"
  }
}
